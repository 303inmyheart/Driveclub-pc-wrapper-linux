// driveclub-pc: native-resolution FXAA and the reference SMAA 1x High passes.
#version 460
#extension GL_GOOGLE_include_directive : require
layout(local_size_x = 8, local_size_y = 8) in;
layout(binding = 0) uniform sampler2D colorTex;
layout(binding = 1) uniform sampler2D edgesTex;
layout(binding = 2) uniform sampler2D blendTex;
layout(binding = 3) uniform sampler2D areaTex;
layout(binding = 4) uniform sampler2D searchTex;
layout(binding = 5, rgba16f) writeonly uniform image2D outputImage;
layout(push_constant) uniform Constants { vec4 metrics; int srgb; } pc;

#if AA_PASS != 0
#define SMAA_GLSL_4 1
#define SMAA_PRESET_HIGH 1
#define SMAA_RT_METRICS pc.metrics
// Compute writes every texel, including zero edges, rather than using a cleared render target.
#define discard
#include "smaa/SMAA.hlsl"
#undef discard
#endif

float luma(vec3 c) { return dot(c, vec3(0.299, 0.587, 0.114)); }
vec4 sampleColor(vec2 uv) { return textureLod(colorTex, uv, 0.0); }

void main() {
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(pixel, ivec2(pc.metrics.zw)))) return;
    vec2 uv = (vec2(pixel) + 0.5) * pc.metrics.xy;
    vec4 result;
#if AA_PASS == 0
    vec2 r = pc.metrics.xy;
    float nw = luma(sampleColor(uv + vec2(-1, -1) * r).rgb);
    float ne = luma(sampleColor(uv + vec2( 1, -1) * r).rgb);
    float sw = luma(sampleColor(uv + vec2(-1,  1) * r).rgb);
    float se = luma(sampleColor(uv + vec2( 1,  1) * r).rgb);
    vec4 center = sampleColor(uv);
    float m = luma(center.rgb);
    float lo = min(m, min(min(nw, ne), min(sw, se)));
    float hi = max(m, max(max(nw, ne), max(sw, se)));
    if (hi - lo < max(0.0312, hi * 0.125)) {
        result = center;
    } else {
        vec2 dir = vec2(-((nw + ne) - (sw + se)), (nw + sw) - (ne + se));
        float reduce = max((nw + ne + sw + se) * (0.25 * 0.125), 1.0 / 128.0);
        dir = clamp(dir / (min(abs(dir.x), abs(dir.y)) + reduce), vec2(-8), vec2(8)) * r;
        vec3 a = 0.5 * (sampleColor(uv + dir * (-1.0 / 6.0)).rgb +
                        sampleColor(uv + dir * ( 1.0 / 6.0)).rgb);
        vec3 b = a * 0.5 + 0.25 * (sampleColor(uv - dir * 0.5).rgb + sampleColor(uv + dir * 0.5).rgb);
        float lb = luma(b);
        result = vec4(lb < lo || lb > hi ? a : b, center.a);
    }
#elif AA_PASS == 1
    // Edge detection on gamma-encoded colours, as required by the SMAA reference implementation.
    vec4 offsets[3];
    SMAAEdgeDetectionVS(uv, offsets);
    vec3 weights = vec3(0.2126, 0.7152, 0.0722);
    float values[7];
    vec2 coords[7] = vec2[7](uv, offsets[0].xy, offsets[0].zw, offsets[1].xy,
                             offsets[1].zw, offsets[2].xy, offsets[2].zw);
    for (int i = 0; i < 7; ++i) {
        vec3 c = sampleColor(coords[i]).rgb;
        if (pc.srgb == 0) c = mix(12.92 * c, 1.055 * pow(max(c, vec3(0)), vec3(1.0/2.4)) - 0.055,
                                  greaterThan(c, vec3(0.0031308)));
        values[i] = dot(c, weights);
    }
    vec2 delta = abs(values[0] - vec2(values[1], values[2]));
    vec2 edges = step(vec2(SMAA_THRESHOLD), delta);
    float maximum = max(max(delta.x, delta.y), max(abs(values[0]-values[3]), abs(values[0]-values[4])));
    maximum = max(maximum, max(abs(values[1]-values[5]), abs(values[2]-values[6])));
    edges *= step(vec2(maximum), SMAA_LOCAL_CONTRAST_ADAPTATION_FACTOR * delta);
    result = vec4(edges, 0, 0);
#elif AA_PASS == 2
    vec4 offsets[3];
    vec2 pixcoord;
    SMAABlendingWeightCalculationVS(uv, pixcoord, offsets);
    result = SMAABlendingWeightCalculationPS(uv, pixcoord, offsets, edgesTex, areaTex, searchTex, vec4(0));
#else
    vec4 offset;
    SMAANeighborhoodBlendingVS(uv, offset);
    result = SMAANeighborhoodBlendingPS(uv, offset, colorTex, blendTex);
#endif
    imageStore(outputImage, pixel, result);
}
